#include <winver.h>
1 ICON "app.ico"
1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040704B0"
    BEGIN
      VALUE "FileDescription", "IRB Thermoviewer"
      VALUE "FileVersion", "1.0.0"
      VALUE "ProductName", "IRB Thermoviewer"
      VALUE "ProductVersion", "1.0.0"
      VALUE "OriginalFilename", "thermoviewer98.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x407, 1200
  END
END
